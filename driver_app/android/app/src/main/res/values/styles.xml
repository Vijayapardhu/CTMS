<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The window the OS draws while the process starts. Removed
         automatically when the Flutter engine draws its first frame. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>

    <!-- In force from the moment the process has started, and behind the
         Flutter UI while it runs. Matched to the launch window so the two
         hand over without a colour change. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/launch_background</item>
    </style>
</resources>
