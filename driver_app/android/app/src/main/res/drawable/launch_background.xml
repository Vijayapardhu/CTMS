<?xml version="1.0" encoding="utf-8"?>
<!-- The launch window, shown by the OS between tapping the icon and Flutter's
     first frame. Deliberately the app's own surface colour with the mark
     centred: a white default followed by a themed app is a flash the driver
     reads as a stutter. No animation — this is on screen for a few hundred
     milliseconds and anything moving would only be half seen. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_logo" />
    </item>
</layer-list>
