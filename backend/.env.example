################################################################################
# CTMS Backend Environment Configuration
################################################################################

# Application
APP_NAME="CTMS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:80
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Maintenance
APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4

# Security
BCRYPT_ROUNDS=12

################################################################################
# Logging Configuration
################################################################################
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

################################################################################
# Database Configuration (PostgreSQL)
################################################################################
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=ctms
DB_USERNAME=ctms_user
DB_PASSWORD=ctms_password

################################################################################
# Session Configuration
################################################################################
SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

################################################################################
# Cache Configuration (Redis)
################################################################################
CACHE_DRIVER=redis
CACHE_PREFIX=ctms_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

################################################################################
# Queue Configuration (Redis)
################################################################################
QUEUE_CONNECTION=redis
QUEUE_FAILED_TABLE=failed_jobs

################################################################################
# Broadcasting Configuration (Reverb WebSocket)
################################################################################
# Off by default, and deliberately.
#
# routes/channels.php calls Broadcast::channel() at boot, so the configured
# connection is built before any command runs. Naming `reverb` here without
# REVERB_APP_ID / REVERB_APP_KEY / REVERB_APP_SECRET made Laravel construct a
# Pusher client with a null key, and every artisan command in a fresh clone
# died on it — key:generate, migrate and test alike.
#
# A template must boot. Credentials belong to a deployment, not to a file in
# the repository, so this stays `null` and each environment turns broadcasting
# on for itself:
#
#     BROADCAST_CONNECTION=reverb
#     REVERB_APP_ID=...
#     REVERB_APP_KEY=...
#     REVERB_APP_SECRET=...
#
# The server/host settings below are harmless with broadcasting off — they are
# read by `php artisan reverb:start`, which an environment only runs once it
# has supplied the credentials above.
BROADCAST_DRIVER=reverb
BROADCAST_CONNECTION=null
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
REVERB_HOST=localhost
REVERB_PORT=8080

################################################################################
# File Storage
################################################################################
FILESYSTEM_DISK=local
FILESYSTEM_VISIBILITY=private

################################################################################
# Mail Configuration
################################################################################
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@ctms.local"
MAIL_FROM_NAME="${APP_NAME}"

################################################################################
# AWS S3 Configuration (Optional - for production file storage)
################################################################################
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

################################################################################
# JWT Configuration
################################################################################
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION=3600

################################################################################
# Third-party Services
################################################################################

# Google Maps Platform (FR-09)
#
# Leave GOOGLE_MAPS_ENABLED false and the system runs on offline estimates:
# straight-line distance at an assumed road speed, labelled as estimates in
# every response. That is a working deployment with rougher ETAs, not a broken
# one — nothing here is required to boot.
#
# Restrict the key in the Cloud console to the five APIs actually used
# (Routes, Route Matrix, Geocoding, Places, Roads). Keep the server key
# separate from any key shipped to a browser, and never commit either.
GOOGLE_MAPS_ENABLED=false
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_REGION=in

# Short on purpose: a slow map call must never hold up GPS ingest.
GOOGLE_MAPS_TIMEOUT_SECONDS=3
GOOGLE_MAPS_RETRIES=2
# How long the circuit breaker stays open after five consecutive failures.
GOOGLE_MAPS_BREAKER_MINUTES=5

# Per-service daily ceilings. 0 means no local ceiling, which leaves the
# billing account as the only limit — that is how surprise invoices happen.
GOOGLE_MAPS_LIMIT_ROUTING=20000
GOOGLE_MAPS_LIMIT_GEOCODING=2000
GOOGLE_MAPS_LIMIT_PLACES=2000
GOOGLE_MAPS_LIMIT_ROADS=20000

# Firebase Cloud Messaging (for notifications)
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_URL=

# SMS Service (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

################################################################################
# Application-Specific Configuration
################################################################################

# CTMS Settings
CTMS_TIMEZONE=UTC
CTMS_COLLEGE_CODE=COLLEGE001
CTMS_COLLEGE_NAME="Your College Name"

# Trip Configuration
TRIP_CHECKIN_WINDOW_MINUTES=15
TRIP_CANCELLATION_DEADLINE_HOURS=2
TRIP_COMPLETION_BUFFER_MINUTES=30

# GPS Configuration
GPS_TRACKING_INTERVAL_SECONDS=30
GPS_ACCURACY_THRESHOLD_METERS=50
GEOFENCE_RADIUS_METERS=100

# Notifications
NOTIFICATION_RETENTION_DAYS=30
ANNOUNCEMENT_RETENTION_DAYS=90

# Rate Limiting
API_RATE_LIMIT_WINDOW_MINUTES=1
API_RATE_LIMIT_REQUESTS=100

# Debug & Development
DEBUGBAR_ENABLED=true
QUERY_LOG_ENABLED=false

################################################################################
# Vite Configuration
################################################################################
VITE_APP_NAME="${APP_NAME}"
