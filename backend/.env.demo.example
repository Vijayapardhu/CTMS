# CTMS — demonstration environment
#
# Everything here is deliberately self-contained: no PostgreSQL, no Redis, no
# queue worker. One command starts it, and it produces the same world every
# time.
#
# This is NOT the production shape. Production is PostgreSQL and Redis, which
# is what `.env.example` describes. The point of this file is that a laptop in
# a meeting room can run the whole system without either of them.
#
# This is the committed TEMPLATE. `demo.ps1` / `demo.sh` copy it to
# `.env.demo` on first run and generate `APP_KEY` there — the working copy
# is ignored, because an application key is a secret even in a demo.
#
# The Maps browser key belongs in `admin_panel/.env.local`, which is also
# not committed. Nothing in this file is a credential.

APP_NAME="CTMS"
APP_ENV=demo
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN
APP_MAINTENANCE_DRIVER=file
APP_TIMEZONE=UTC

# One file, thrown away and rebuilt by `php artisan ctms:demo --fresh`.
DB_CONNECTION=sqlite
DB_DATABASE=database/demo.sqlite

# Synchronous, so a notification really is dispatched during the demonstration
# rather than waiting on a worker nobody remembered to start.
QUEUE_CONNECTION=sync
CACHE_DRIVER=file
CACHE_STORE=file
CACHE_PREFIX=ctms_demo_
SESSION_DRIVER=file
SESSION_LIFETIME=120
BROADCAST_DRIVER=null
BROADCAST_CONNECTION=null

LOG_CHANNEL=stack
LOG_LEVEL=debug

# Notifications are written to the delivery log and go no further. Nothing in a
# demonstration should reach a real handset or a real inbox.
MAIL_MAILER=log
NOTIFICATIONS_PUSH_ENABLED=false
NOTIFICATIONS_SMS_ENABLED=false

# Signed at rest. Generated on first run by demo.ps1 / demo.sh, exactly like
# APP_KEY — a demonstration still signs real tokens, and an empty key is
# refused at boot rather than silently accepted.
JWT_SECRET=

JWT_TTL=3600
JWT_REFRESH_TTL=1209600

# Server-side routing. Without a key the backend falls back to its offline
# estimate and labels the distance as an estimate — which is a state worth
# demonstrating in its own right.
GOOGLE_MAPS_SERVER_KEY=
