# The CTMS API this build talks to. No trailing slash.
VITE_CTMS_API_BASE_URL=http://localhost:8000/api/v1

# development | staging | production
VITE_CTMS_ENV=development

# The BROWSER Maps key. This is a third credential, separate from the server
# key in backend/.env and from the Android key in driver_app. Restrict it by
# HTTP referrer to this panel's origin, and enable ONLY the Maps JavaScript
# API on it — the browser needs nothing else, because routing, road distance
# and ETA are all computed server-side.
#
# Anything compiled into a browser bundle can be read out of it. The server key
# must never appear here.
#
# Absent is a supported state: Live Operations renders the trip list and every
# detail panel, and says the map is not configured.
VITE_GOOGLE_MAPS_API_KEY=
