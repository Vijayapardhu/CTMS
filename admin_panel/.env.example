# The CTMS API this build talks to. No trailing slash.
VITE_CTMS_API_BASE_URL=http://localhost:8000/api/v1

# development | staging | production
VITE_CTMS_ENV=development

# Browser Maps key — HTTP-referrer restricted, Maps JavaScript API only.
# Not needed until slice 4; the panel runs without it.
VITE_GOOGLE_MAPS_BROWSER_KEY=
